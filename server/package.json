{
  "name": "server",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch --exclude \"**/.yjs-data/**\" --exclude \"**/*.log\" --exclude \"**/*.ldb\" src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:api": "node dist/server.js",
    "start:realtime": "node dist/src/realtimeEntry.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@docket/shared": "*",
    "@google/genai": "^2.12.0",
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "html-to-docx": "^1.8.0",
    "lib0": "^0.2.99",
    "mammoth": "^1.8.0",
    "multer": "^2.2.0",
    "openai": "^6.48.0",
    "pdfjs-dist": "^6.1.200",
    "pg-boss": "^10.1.5",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.21"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
