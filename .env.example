# ---- Server ----
# Neon Postgres connection string (pooled). Prisma needs this to migrate/seed/run.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/docket?sslmode=require"
# Direct (non-pooled) URL for migrations, if using Neon pooling.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/docket?sslmode=require"

# Claude API key for Viki.
ANTHROPIC_API_KEY="sk-ant-..."
# Model id — latest Claude by default.
VIKI_MODEL="claude-opus-4-8"

# Server ports
PORT=4000
YJS_PORT=4001

# Where server-side Yjs snapshots are persisted (y-leveldb).
YJS_DATA_DIR="./.yjs-data"

# Max concurrent LLM calls (rate-limit + memory protection).
LLM_CONCURRENCY=4
# Max agentic turns Viki may take within ONE run before a hard stop (cost/
# runaway-loop gate). Viki decides on its own via stage_changes' "done" flag
# when it's genuinely finished — this is only the backstop.
VIKI_MAX_ITERATIONS=4
# Enable Anthropic server-side web search for template drafting (account-gated).
VIKI_WEB_SEARCH=false
# Set to "external" to run the queue worker as a separate process (scripts/worker.ts)
# instead of in-process. Default: in-process.
# WORKER_MODE=external

# ---- Web ----
VITE_API_URL="http://localhost:4000"
VITE_YJS_WS_URL="ws://localhost:4001"
